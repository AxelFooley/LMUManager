<Window x:Class="LMUManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LMU Manager"
        Width="780" Height="620"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Closing="Window_Closing">

    <Window.Resources>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="LMU MANAGER" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Launch Le Mans Ultimate with your companion apps - one click."
                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Game -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="LE MANS ULTIMATE" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" Grid.Column="0" x:Name="GamePathBox"
                                     Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="BrowseGame_Click"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="Auto-detect" Margin="8,0,0,0" Click="DetectGame_Click"/>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="GAME ARGUMENTS" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="GameArgsBox"
                                             Text="{Binding GameArguments, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Optional startup parameters passed to the game - same as Steam's Launch Options"/>
                                    <TextBlock IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                                               Text="Optional - extra startup parameters, e.g. flags from Steam &quot;Launch Options&quot;">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text.Length, ElementName=GameArgsBox}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Companion apps -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="COMPANION APPS" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConfigPathText" Foreground="{StaticResource MutedBrush}" FontSize="10"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <ItemsControl x:Name="AppsList" ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                                     ToolTip="Display name"/>
                                            <TextBox Grid.Column="2" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                                     ToolTip="Full path to the application .exe"/>
                                            <Button Grid.Column="3" Content="..." Width="34" Margin="0,0,8,0" Click="BrowseApp_Click" ToolTip="Browse for executable"/>
                                            <TextBox Grid.Column="4" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                                     ToolTip="Optional command-line arguments"/>
                                            <Button Grid.Column="5" Width="30" Click="RemoveApp_Click" ToolTip="Remove this app">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Margin="0,0,-1,0"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="+ Add app" HorizontalAlignment="Left" Margin="0,10,0,0" Click="AddApp_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer / actions -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource OkBrush}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Text="Ready."/>
                <CheckBox Grid.Column="1" x:Name="StartWithWindowsCheck" Content="Start with Windows"
                          VerticalAlignment="Center" Margin="0,0,12,0"
                          Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed"/>
                <CheckBox Grid.Column="2" x:Name="CloseOnExitCheck" IsChecked="{Binding CloseCompanionsOnExit}"
                          Content="Close apps when LMU exits" Foreground="{StaticResource MutedBrush}"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Grid.Column="3" x:Name="LaunchButton" Click="Launch_Click" Padding="28,10"
                        Background="{StaticResource AccentBrush}" FontWeight="ExtraBold" FontSize="15"
                        Content="LAUNCH"/>
            </Grid>
        </Border>
    </Grid>
</Window>
